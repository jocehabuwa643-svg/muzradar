# Скопируйте в .env (он в .gitignore). В продакшене переменные задаются окружением.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Не задан → Postgres в процессе (PGlite, данные в .data/pglite). В продакшене обязателен.
# DATABASE_URL=postgres://muzradar:***@db.internal:5432/muzradar
# Не задан → присутствие и лимиты в памяти процесса (одна нода).
# REDIS_URL=redis://127.0.0.1:6379

# ≥ 32 случайных символов каждый; в продакшене обязательны. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
PRESENCE_JITTER_SECRET=
ANDROID_ID_PEPPER=

# CIDR-список доверенных прокси (не число!), например 10.0.0.0/8
TRUST_PROXY=
CORS_ORIGINS=
# CDN для аватаров; пусто → относительные ссылки /v1/avatars/...
ASSETS_BASE_URL=

# Источники музыки
AUDIUS_API_KEY=
AUDIUS_APP_NAME=MUZRADAR
JAMENDO_CLIENT_ID=
LISTENBRAINZ_TOKEN=
# 1 — подмешивать в «Для вас» похожих артистов (MusicBrainz → ListenBrainz labs, без токена).
# Имена артистов из профиля уходят в MetaBrainz; выключено — туда не уходит ни одного запроса.
LISTENBRAINZ_SIMILAR_ARTISTS=
MB_USER_AGENT=MuzRadar/0.1 ( you@example.com )
