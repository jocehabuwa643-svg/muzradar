{
  "name": "@muzradar/server",
  "version": "0.1.0",
  "private": true,
  "description": "МУЗРАДАР API: аутентификация устройств, профиль, аватары, каталог, присутствие на карте",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --conditions=@muzradar/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "npm run build -w @muzradar/shared && drizzle-kit generate",
    "smoke": "tsx --conditions=@muzradar/source scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.8",
    "@muzradar/shared": "*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "sharp": "0.35.4",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-postgis": "0.2.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "0.31.10",
    "socket.io-client": "4.8.3",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "vitest": "5.0.1"
  }
}
