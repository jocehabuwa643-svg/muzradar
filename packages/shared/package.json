{
  "name": "@muzradar/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Контракты МУЗРАДАРА: zod-схемы API, события реалтайма, гео-утилиты",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@muzradar/source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "5.0.1"
  }
}
